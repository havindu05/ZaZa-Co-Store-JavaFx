        <Text fill="WHITE" layoutX="6.0" layoutY="243.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Name         :">
            <font>
                <Font name="Cochin" size="18.0" />
            </font>
        </Text>
        <TextField fx:id="txtName" layoutX="112.0" layoutY="223.0" prefHeight="26.0" prefWidth="283.0"
