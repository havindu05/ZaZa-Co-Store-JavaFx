            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.customerController.CustomerFormController">

    <children>
        <Rectangle arcHeight="5.0" arcWidth="5.0" height="520.0" layoutX="1.0" layoutY="2.0" stroke="WHITE" strokeType="INSIDE"
                   style="-fx-arc-height: 50; -fx-arc-width: 50;" width="407.0" />

        <Text fill="#fff3f3" layoutX="103.0" layoutY="36.0" strokeType="OUTSIDE" strokeWidth="0.0" textAlignment="CENTER" wrappingWidth="191.0">
            <font>
                <Font name="Copperplate Bold" size="33.0" />
            </font>
        </Text>

        <Text fill="WHITE" layoutX="137.0" layoutY="38.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Buy Now">
            <font>
                <Font name="Brush Script MT Italic" size="38.0" />
            </font>
        </Text>
        <Text fill="WHITE" layoutX="9.0" layoutY="125.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Phone       :">
            <font>
                <Font name="Cochin" size="18.0" />
