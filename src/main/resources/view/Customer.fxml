        <Text fill="WHITE" layoutX="6.0" layoutY="181.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Title           :">
            <font>
                <Font name="Cochin" size="18.0" />
            </font>
        </Text>
        <ComboBox fx:id="cmbTitle" layoutX="111.0" layoutY="161.0" prefHeight="28.0" prefWidth="284.0"
